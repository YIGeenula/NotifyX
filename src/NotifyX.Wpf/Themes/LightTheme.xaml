<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Colors -->
    <Color x:Key="MainBackgroundColor">#F5F7FC</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
    <Color x:Key="CardBorderColor">#E2E8F0</Color>
    <Color x:Key="CardHoverColor">#F8FAFC</Color>

    <Color x:Key="PrimaryAccentColor">#7055E8</Color>
    <Color x:Key="PrimaryAccentHoverColor">#5C41DB</Color>
    <Color x:Key="SecondaryAccentColor">#12A995</Color>

    <Color x:Key="PrimaryTextColor">#202638</Color>
    <Color x:Key="SecondaryTextColor">#788196</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <Color x:Key="WarningColor">#D97706</Color>
    <Color x:Key="DangerColor">#DC2626</Color>
    <Color x:Key="InfoColor">#0284C7</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1"/>

    <!-- Refined Navigation & Brand Colors -->
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="NavActiveIndicatorBrush" Color="#2563EB"/>
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="BrandBadgeBackgroundBrush" Color="#EFF6FF"/>
    <SolidColorBrush x:Key="BrandBadgeBorderBrush" Color="#BFDBFE"/>
    <SolidColorBrush x:Key="BrandBadgeTextBrush" Color="#1D4ED8"/>
</ResourceDictionary>
