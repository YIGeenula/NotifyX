<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Colors -->
    <Color x:Key="MainBackgroundColor">#10131C</Color>
    <Color x:Key="SecondaryBackgroundColor">#171C29</Color>
    <Color x:Key="CardBackgroundColor">#1D2433</Color>
    <Color x:Key="CardBorderColor">#2A3245</Color>
    <Color x:Key="CardHoverColor">#232B3D</Color>

    <Color x:Key="PrimaryAccentColor">#7C5CFC</Color>
    <Color x:Key="PrimaryAccentHoverColor">#6846F5</Color>
    <Color x:Key="SecondaryAccentColor">#21C8B7</Color>

    <Color x:Key="PrimaryTextColor">#F4F6FC</Color>
    <Color x:Key="SecondaryTextColor">#929BB0</Color>
    <Color x:Key="MutedTextColor">#656E82</Color>

    <Color x:Key="SuccessColor">#2ECC8A</Color>
    <Color x:Key="WarningColor">#F5B942</Color>
    <Color x:Key="DangerColor">#F06464</Color>
    <Color x:Key="InfoColor">#38A3F8</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="MainBackgroundBrush" Color="{StaticResource MainBackgroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}"/>

    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryAccentHoverBrush" Color="{StaticResource PrimaryAccentHoverColor}"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}"/>

    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#151A26"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E374D"/>

    <!-- Refined Navigation & Brand Colors -->
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="NavActiveIndicatorBrush" Color="#3B82F6"/>
    <SolidColorBrush x:Key="NavActiveBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BrandBadgeBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BrandBadgeBorderBrush" Color="#334155"/>
    <SolidColorBrush x:Key="BrandBadgeTextBrush" Color="#38BDF8"/>
</ResourceDictionary>
