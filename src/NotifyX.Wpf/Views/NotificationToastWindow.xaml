<Window x:Class="CodexBlaze.PaymentReminder.Wpf.Views.NotificationToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Payment Reminder Notification"
        Height="115" Width="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">

    <Window.Resources>
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.3"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#1D2433" BorderBrush="#7C5CFC" BorderThickness="1.5" CornerRadius="12" Margin="6" Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.45" BlurRadius="16" Direction="270" ShadowDepth="4"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon Indicator -->
            <Border Width="38" Height="38" CornerRadius="10" Background="#7C5CFC" VerticalAlignment="Top">
                <TextBlock Text="🔔" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Content -->
            <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="ToastTitle" Text="Payment Due Reminder!" FontWeight="Bold" FontSize="14" Foreground="#F4F6FC" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ToastMessage" Text="Your Mintpay installment is due soon." FontSize="12" Foreground="#929BB0" TextWrapping="Wrap" Margin="0,3,0,0" MaxHeight="45"/>
            </StackPanel>

            <!-- Close Button -->
            <Button Grid.Column="2" Content="✕" Width="24" Height="24" Background="Transparent" Foreground="#929BB0" BorderThickness="0" Cursor="Hand" Click="CloseButton_Click" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="12"/>
        </Grid>
    </Border>
</Window>
