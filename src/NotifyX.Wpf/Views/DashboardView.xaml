<UserControl x:Class="CodexBlaze.PaymentReminder.Wpf.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,10,20">
            <!-- Filter Bar -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Financial Overview &amp; Provider Dashboards" Style="{StaticResource HeaderTitleText}"/>
                    <TextBlock Text="Switch between Overall and dedicated Mintpay, Koko, and Payzy dashboards." Style="{StaticResource SubheaderText}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox SelectedValue="{Binding SelectedFilter}" SelectedValuePath="Content" Style="{StaticResource ModernComboBox}" Width="160" Margin="0,0,10,0">
                        <ComboBoxItem Content="All Time" IsSelected="True"/>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last Month"/>
                        <ComboBoxItem Content="Last 3 Months"/>
                        <ComboBoxItem Content="This Year"/>
                    </ComboBox>
                    <Button Content="Refresh" Command="{Binding LoadDashboardCommand}" Style="{StaticResource SecondaryButton}"/>
                </StackPanel>
            </Grid>

            <!-- Provider Dedicated Dashboards Navigation Tabs -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,20" Padding="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- All Overview Tab -->
                    <Button Grid.Column="0" Command="{Binding SwitchDashboardTabCommand}" CommandParameter="Overview" Margin="2" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Overview">
                                                                <Setter Property="Background" Value="{DynamicResource PrimaryAccentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="🌐" FontSize="15" Margin="0,0,8,0"/>
                                                    <TextBlock Text="All Providers Overview" FontWeight="Bold" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Overview">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Mintpay Dedicated Dashboard Tab -->
                    <Button Grid.Column="1" Command="{Binding SwitchDashboardTabCommand}" CommandParameter="Mintpay" Margin="2" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Mintpay">
                                                                <Setter Property="Background" Value="#00D1B2"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="#00D1B2" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Mintpay">
                                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="Mintpay Dashboard" FontWeight="Bold" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Mintpay">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Koko Dedicated Dashboard Tab -->
                    <Button Grid.Column="2" Command="{Binding SwitchDashboardTabCommand}" CommandParameter="Koko" Margin="2" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Koko">
                                                                <Setter Property="Background" Value="#FF3860"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="#FF3860" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Koko">
                                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="Koko Dashboard" FontWeight="Bold" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Koko">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Payzy Dedicated Dashboard Tab -->
                    <Button Grid.Column="3" Command="{Binding SwitchDashboardTabCommand}" CommandParameter="Payzy" Margin="2" Height="40" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border CornerRadius="8" Padding="12,8">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Payzy">
                                                                <Setter Property="Background" Value="#7C5CFC"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Border Width="10" Height="10" CornerRadius="5" Background="#7C5CFC" Margin="0,0,8,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Payzy">
                                                                        <Setter Property="Background" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <TextBlock Text="Payzy Dashboard" FontWeight="Bold" FontSize="13">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ActiveDashboardTab}" Value="Payzy">
                                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <!-- 6 Key Stats Cards Grid (Responsive min-widths and tabular figures) -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Purchase Value -->
                <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL PURCHASES" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding TotalPurchaseValue, Converter={StaticResource CurrencyFormatter}}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="All registered items" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Total Paid Amount -->
                <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="TOTAL PAID" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding TotalPaidAmount, Converter={StaticResource CurrencyFormatter}}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="Settled installments" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Outstanding Balance -->
                <Border Grid.Column="2" Style="{StaticResource PremiumCard}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="OUTSTANDING" Foreground="{DynamicResource PrimaryAccentBrush}" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding TotalOutstandingBalance, Converter={StaticResource CurrencyFormatter}}" Foreground="{DynamicResource PrimaryAccentBrush}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        <TextBlock Text="Remaining to settle" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Upcoming Installments -->
                <Border Grid.Column="3" Style="{StaticResource PremiumCard}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="UPCOMING" Foreground="{DynamicResource InfoBrush}" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding UpcomingInstallmentsCount}" Foreground="{DynamicResource InfoBrush}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3"/>
                        <TextBlock Text="Pending payments" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Overdue Installments -->
                <Border Grid.Column="4" Style="{StaticResource PremiumCard}" Margin="6,0,6,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="OVERDUE" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding OverdueInstallmentsCount}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3"/>
                        <TextBlock Text="Requires attention" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <!-- Completed Purchases -->
                <Border Grid.Column="5" Style="{StaticResource PremiumCard}" Margin="6,0,0,0" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="COMPLETED" Style="{StaticResource StatCardLabelText}"/>
                        <TextBlock Text="{Binding CompletedPurchasesCount}" Style="{StaticResource StatCardValueText}" Margin="0,6,0,3"/>
                        <TextBlock Text="Fully settled purchases" Style="{StaticResource SubheaderText}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Middle Row: Provider Breakdown & Monthly Trend -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="1.8*"/>
                </Grid.ColumnDefinitions>

                <!-- Provider Distribution -->
                <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,12,0" MinHeight="210">
                    <StackPanel>
                        <TextBlock Text="Spending by Provider" Style="{StaticResource HeaderTitleText}" FontSize="16"/>
                        <TextBlock Text="Real-time distribution across active providers" Style="{StaticResource SubheaderText}" Margin="0,2,0,14"/>

                        <!-- Populated items -->
                        <ItemsControl ItemsSource="{Binding ProviderSpendings}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10" Padding="12" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProviderName}" FontWeight="SemiBold" FontSize="14"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="Paid: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding TotalPaid, Converter={StaticResource CurrencyFormatter}}" FontSize="11" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,12,0" Typography.NumeralAlignment="Tabular"/>
                                                    <TextBlock Text="Rem: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                                    <TextBlock Text="{Binding TotalOutstanding, Converter={StaticResource CurrencyFormatter}}" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" Typography.NumeralAlignment="Tabular"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalSpent, Converter={StaticResource CurrencyFormatter}}" FontWeight="Bold" VerticalAlignment="Center" FontSize="14" Typography.NumeralAlignment="Tabular"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State Placeholder -->
                        <Border Style="{StaticResource EmptyStateCardPlaceholder}" Visibility="{Binding ProviderSpendings.Count, Converter={StaticResource CountToZeroVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="No provider spending recorded" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Transactions grouped by BNPL providers will appear here." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Monthly Overview -->
                <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Margin="12,0,0,0" MinHeight="210">
                    <StackPanel>
                        <TextBlock Text="Monthly Payment Timeline" Style="{StaticResource HeaderTitleText}" FontSize="16"/>
                        <TextBlock Text="Due vs Paid comparison across recent months" Style="{StaticResource SubheaderText}" Margin="0,2,0,14"/>

                        <ItemsControl ItemsSource="{Binding MonthlyOverviews}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="150"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding MonthName}" FontWeight="Medium" VerticalAlignment="Center"/>
                                        
                                        <!-- Visual comparison bar -->
                                        <Grid Grid.Column="1" Height="14" Margin="10,0">
                                            <ProgressBar Value="100" Maximum="100" Height="10" Foreground="{DynamicResource CardBorderBrush}" Background="{DynamicResource SecondaryBackgroundBrush}"/>
                                        </Grid>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <TextBlock Text="Paid: " FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            <TextBlock Text="{Binding TotalPaid, Converter={StaticResource CurrencyFormatter}}" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}" Margin="0,0,8,0" Typography.NumeralAlignment="Tabular"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State Placeholder -->
                        <Border Style="{StaticResource EmptyStateCardPlaceholder}" Visibility="{Binding MonthlyOverviews.Count, Converter={StaticResource CountToZeroVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="No monthly payment timeline data" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Monthly installment progress will chart here as payments are logged." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Bottom Row: Upcoming Payments Timeline & Recent Purchases -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <!-- Upcoming Timeline -->
                <Border Grid.Column="0" Style="{StaticResource PremiumCard}" Margin="0,0,12,0" MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Upcoming Due Payments" Style="{StaticResource HeaderTitleText}" FontSize="16"/>
                        <TextBlock Text="Immediate installments pending settlement" Style="{StaticResource SubheaderText}" Margin="0,2,0,14"/>

                        <ItemsControl ItemsSource="{Binding UpcomingInstallments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Purchase.ItemName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Purchase.Provider.Name}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding RemainingAmount, Converter={StaticResource CurrencyFormatter}}" FontWeight="Bold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding DueDate, StringFormat='Due {0:MMM dd, yyyy}'}" FontSize="11" Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State Placeholder -->
                        <Border Style="{StaticResource EmptyStateCardPlaceholder}" Visibility="{Binding UpcomingInstallments.Count, Converter={StaticResource CountToZeroVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="No upcoming payments due" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="You are completely up-to-date with your installment commitments." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Recent Purchases -->
                <Border Grid.Column="1" Style="{StaticResource PremiumCard}" Margin="12,0,0,0" MinHeight="180">
                    <StackPanel>
                        <TextBlock Text="Recent Purchases" Style="{StaticResource HeaderTitleText}" FontSize="16"/>
                        <TextBlock Text="Newly added installment plans" Style="{StaticResource SubheaderText}" Margin="0,2,0,14"/>

                        <ItemsControl ItemsSource="{Binding RecentPurchases}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8" Padding="10" Background="{DynamicResource SecondaryBackgroundBrush}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Provider.Name}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding TotalAmount, Converter={StaticResource CurrencyFormatter}}" FontWeight="Bold" HorizontalAlignment="Right" Typography.NumeralAlignment="Tabular"/>
                                                <TextBlock Text="{Binding PurchaseDate, StringFormat='MMM dd, yyyy'}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty State Placeholder -->
                        <Border Style="{StaticResource EmptyStateCardPlaceholder}" Visibility="{Binding RecentPurchases.Count, Converter={StaticResource CountToZeroVisConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,8">
                                <TextBlock Text="No purchases registered yet" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" FontSize="13"/>
                                <TextBlock Text="Add your first purchase to begin tracking installments and schedules." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center" FontSize="11" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
