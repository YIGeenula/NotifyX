<UserControl x:Class="CodexBlaze.PaymentReminder.Wpf.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1050">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,10,20">
            <!-- Header -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="System Settings &amp; Preferences" Style="{StaticResource HeaderTitleText}"/>
                <TextBlock Text="Configure reminders, theme, backup, and Excel export/import options." Style="{StaticResource SubheaderText}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Status Banner -->
            <Border Background="{DynamicResource CardHoverBrush}" BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
            </Border>

            <!-- Software Updates (GitHub Releases) -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="🚀 Software Updates &amp; Version" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentAppVersion, StringFormat='Installed: v{0}'}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="Check for official updates released on GitHub. Updates are securely downloaded directly from GitHub Releases with full privacy." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>

                    <!-- Update status text -->
                    <TextBlock Text="{Binding UpdateInfoText}" FontWeight="Medium" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,0,0,12"/>

                    <!-- Progress bar when downloading -->
                    <StackPanel Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisConverter}}" Margin="0,0,0,12">
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="8" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding DownloadProgress, StringFormat='Downloading: {0}%'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <!-- Release Notes when update available -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}">
                        <StackPanel>
                            <TextBlock Text="{Binding LatestVersionTag, StringFormat='Release Notes for v{0}:'}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding ReleaseNotes}" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Check for Updates" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Download &amp; Install Update" Command="{Binding DownloadAndInstallUpdateCommand}" Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVisConverter}}" Style="{StaticResource PrimaryButton}" Background="#10B981" Margin="0,0,10,0"/>
                        <Button Content="View on GitHub Releases" Command="{Binding OpenReleasesPageCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Appearance -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Theme" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="Choose between Premium Dark mode and Clean Light mode." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Dark Theme" Command="{Binding SwitchThemeCommand}" CommandParameter="Dark" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Light Theme" Command="{Binding SwitchThemeCommand}" CommandParameter="Light" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Cloud Vault & Live Web Dashboard Sync -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="☁️ Cloud Vault &amp; Live Web Dashboard" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <Border Background="{DynamicResource CardHoverBrush}" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                            <TextBlock Text="100% Free &amp; Fully Automated" FontSize="11" Foreground="{DynamicResource PrimaryAccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                    </DockPanel>
                    <TextBlock Text="Your purchases and payment schedules automatically sync to your private cloud vault. Open your Web Dashboard on any phone or browser to track your finances anywhere." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>

                    <!-- User Vault Key Card -->
                    <Border Background="{DynamicResource BackgroundBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Your Private Cloud Vault Key:" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding UserVaultId}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryAccentBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="📋 Copy Key" Command="{Binding CopyVaultIdCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4"/>
                                <Button Content="🌐 Open Web Dashboard" Command="{Binding OpenWebDashboardCommand}" Style="{StaticResource PrimaryButton}" Padding="12,6"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Advanced Cloud Webhook URL (Pre-configured) -->
                    <Expander Header="Advanced: Custom Google Apps Script Webhook API" Foreground="{DynamicResource TextMutedBrush}" FontSize="12">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Cloud Webhook Endpoint:" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding GoogleSheetSyncUrl, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" FontSize="12" Margin="0,0,0,8"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Save Custom URL" Command="{Binding SaveSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4"/>
                                <Button Content="Force Push to Cloud" Command="{Binding SyncAllToGoogleSheetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="10,4"/>
                                <Button Content="Pull Cloud Records" Command="{Binding PullFromGoogleSheetCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Notification Rules -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Desktop Notification Preferences" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="Customize reminder thresholds before installment due dates." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>

                    <CheckBox Content="Enable System Notifications" IsChecked="{Binding NotificationsEnabled}" Margin="0,0,0,8"/>
                    <CheckBox Content="Remind 7 days before due date" IsChecked="{Binding Remind7Days}" Margin="0,0,0,8"/>
                    <CheckBox Content="Remind 3 days before due date" IsChecked="{Binding Remind3Days}" Margin="0,0,0,8"/>
                    <CheckBox Content="Remind 1 day before due date" IsChecked="{Binding Remind1Day}" Margin="0,0,0,8"/>
                    <CheckBox Content="Remind on due date" IsChecked="{Binding RemindDueDay}" Margin="0,0,0,8"/>
                    <CheckBox Content="Remind when payment is overdue" IsChecked="{Binding RemindOverdue}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Save Notification Preferences" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Trigger Test Notification" Command="{Binding TriggerTestNotificationCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Backup & Restore -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="Database Backup &amp; Restore" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="Generate compressed .cbz backup archives or restore from previous points." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Create New Backup (.cbz)" Command="{Binding CreateBackupCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Restore from Backup (.cbz)" Command="{Binding RestoreBackupCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Excel Export & Import -->
            <Border Style="{StaticResource PremiumCard}" Margin="0,0,0,16" Padding="16">
                <StackPanel>
                    <TextBlock Text="ClosedXML Excel Export &amp; Import" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <TextBlock Text="Export all purchases, schedules, and payment histories to a multi-sheet spreadsheet or restore from an existing Excel template." Style="{StaticResource SubheaderText}" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="Export to Excel (.xlsx)" Command="{Binding ExportExcelCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="Import from Excel (.xlsx)" Command="{Binding ImportExcelCommand}" Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Notification History Log -->
            <Border Style="{StaticResource PremiumCard}" Padding="16">
                <StackPanel>
                    <TextBlock Text="Recent Notification Logs" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Audit log of alert notifications recorded by the reminder scheduler." Style="{StaticResource SubheaderText}" VerticalAlignment="Center"/>
                        <Button Content="Clear Logs" Command="{Binding ClearNotificationLogsCommand}" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" Padding="10,4"/>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding NotificationHistoryList}" Style="{StaticResource ModernDataGrid}" MaxHeight="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding NotificationType}" Width="100"/>
                            <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="200"/>
                            <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="2.5*"/>
                            <DataGridTextColumn Header="Sent Timestamp" Binding="{Binding SentAt, StringFormat='yyyy-MM-dd HH:mm'}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
